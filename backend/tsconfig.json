{
  "compilerOptions": {
    /* Language & runtime */
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",

    /* Paths */
    "rootDir": "src",
    "outDir": "dist",

    /* Node compatibility */
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Type safety */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Build behavior */
    "sourceMap": true,
    "removeComments": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
