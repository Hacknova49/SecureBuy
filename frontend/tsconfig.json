{
  "compilerOptions": {
    // Target modern Node.js features
    "target": "ES2022",
    
    // **CRITICAL FIX 1:** Use CommonJS module system (standard for Node.js)
    "module": "CommonJS", 
    
    // **CRITICAL FIX 2:** Use Node.js module resolution strategy 
    "moduleResolution": "node",
    
    // Allow standard ES import syntax (`import`) to work with CommonJS
    "esModuleInterop": true,
    "jsx": "react-jsx",

    // Standard library definitions (backend-only)
    "lib": ["ES2022"],
    
    // General config
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": false, 
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true
  },
  
  // Include all .ts files in the src folder of the backend
  "include": [
    "backend/src/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ], 
  "exclude": ["node_modules", "dist", "build"]
}